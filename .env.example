# =====================================================================
# Public — bundled into the client. Safe to expose.
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================================
# Server-only — NEVER import these in client components.
# Anything in this section leaking to the browser is a security incident.
# =====================================================================

# Bypasses RLS. Only use in API route handlers or server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Used to sign Cloudinary upload params server-side.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: unsubscribe-token signing secret (HMAC).
UNSUBSCRIBE_SECRET=
